# 복사해서 .env.local 로 쓰거나, 로컬 개발이면 `pnpm env:local` 로 자동 생성한다.
# 비밀 키는 코드·git 에 넣지 않는다. 배포 환경에서는 Vercel 환경 변수에 넣는다.

# Supabase 프로젝트 주소와 공개(publishable) 키 — 브라우저에 노출돼도 되는 값
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 비밀 키 — 절대 NEXT_PUBLIC_ 로 시작하게 바꾸지 말 것
SUPABASE_SECRET_KEY=

# 카카오 로그인 (Supabase 대시보드 또는 supabase/config.toml 에서 사용)
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=

# 운영자 화면(/admin) 초대 코드 — 8자 이상. 이 코드를 아는 사람의 계정이 운영자가 된다.
OPERATOR_INVITE_CODE=
